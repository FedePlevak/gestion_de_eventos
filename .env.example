# Entorno y URLs
APP_URL=http://localhost:3000
APP_ENV=development

# Pepper secreto para HMAC de canje de enlaces familiares (32+ caracteres)
FAMILY_TOKEN_PEPPER=un-secreto-de-desarrollo-local-minimo-32-caracteres-para-hmac

# Configuración pública de Firebase para el navegador (sólo para Auth de organizadores)
NEXT_PUBLIC_FIREBASE_API_KEY=dev-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gestion-eventos-dev

# Configuración privada de Firebase Admin SDK para el servidor
FIREBASE_PROJECT_ID=gestion-eventos-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dev@gestion-eventos-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=gestion-eventos-dev.appspot.com

# Destinos de Emuladores locales (sólo en desarrollo/pruebas)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
